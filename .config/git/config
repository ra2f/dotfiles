# https://git-scm.com/docs/git-config
[user]
  # Sign commits and tags with the SSH key.
  signingkey = ~/.ssh/id_ed25519.pub
  # Don't guess the user's identity.
  useConfigOnly = true

[branch]
  sort = -committerdate

[commit]
  verbose = true

[core]
  abbrev = 12
  excludesfile = ~/.config/git/ignore
  eol = lf
  autocrlf = false
  fileMode = false
  pager = delta

[diff]
  # algorithm = histogram
  # colorMoved = default

[fetch]
  prune = true
  pruneTag = true

[init]
  defaultBranch = master

[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f

[interactive]
  diffFilter = delta --color-only

[merge]
  # conflictStyle = zdiff3

[pull]
	rebase = false

[push]
  # Make `git push` automatically push relevant
  # annotated tags when pushing branches out.
  autoSetupRemote = true
  default = simple
  followTags = true

[rebase]
  autosquash = true

[color]
  ui = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow
  frag = magenta bold
  old = red bold
  new = green bold
  commit = yellow bold
  whitespace = red reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[delta]
  features = catppuccin-mocha
  syntax-theme = Catppuccin Mocha
  navigate = true
  line-numbers = true
  hunk-header-style = omit
  file-modified-label =
  hyperlinks = true
  true-color = always

[diff "bin"]
  # Use `hexdump` to diff binary files.
  textconv = hexdump -v -C

[pager]
  log = delta
  reflog = delta
  show = delta
  blame = delta
  grep = delta

[interactive]
  diffFilter = delta --color-only

[rerere]
  enabled = true

[include]
  path = ~/.config/git/aliases

[include]
  # Include commit template
  path = ~/.config/git/commit

# Commit signing
[commit]
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
